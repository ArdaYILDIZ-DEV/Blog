---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getModel } from '../../lib/content';
import { getAlternate, type Post, type Category, type Tag } from '../../lib/model';
import { languages, otherLang, t, type Lang } from '../../lib/i18n';
import { withBase } from '../../lib/urls';
type Route = { kind: 'article'; post: Post } | { kind: 'category'; category: Category } | { kind: 'tag'; tag: Tag } | { kind: 'tags' | 'search' };
interface Props { route: Route; }
export async function getStaticPaths() {
  const model = await getModel();
  const routes: { lang: Lang; path: string; route: Route }[] = [
    ...model.posts.map((post) => ({ lang: post.lang, path: post.path, route: { kind: 'article' as const, post } })),
    ...model.categories.map((category) => ({ lang: category.lang, path: category.path, route: { kind: 'category' as const, category } })),
    ...model.tags.map((tag) => ({ lang: tag.lang, path: tag.path, route: { kind: 'tag' as const, tag } })),
    ...languages.flatMap((lang) => (['tags', 'search'] as const).map((kind) => ({ lang, path: `/${lang}/${kind}/`, route: { kind } }))),
  ];
  return routes.map(({ lang, path, route }) => ({ params: { lang, path: decodeURIComponent(path.split('/').slice(2).filter(Boolean).join('/')) }, props: { route } }));
}
const { route } = Astro.props;
const lang = Astro.params.lang as Lang;
const text = t(lang);
const model = await getModel();
const path = route.kind === 'article' ? route.post.path : route.kind === 'category' ? route.category.path : route.kind === 'tag' ? route.tag.path : `/${lang}/${route.kind}/`;
const post = route.kind === 'article' ? route.post : undefined;
const title = route.kind === 'article' ? route.post.title : route.kind === 'category' ? route.category.label : route.kind === 'tag' ? route.tag.label : route.kind === 'tags' ? text.tags : text.search;
const description = post?.description ?? text.siteDescription;
const alternates: Partial<Record<Lang, string>> = { [lang]: path };
if (post) { const alternate = getAlternate(model, post, otherLang(lang)); if (alternate) alternates[otherLang(lang)] = alternate.path; }
else if (route.kind === 'tags' || route.kind === 'search') alternates[otherLang(lang)] = `/${otherLang(lang)}/${route.kind}/`;
const rendered = post ? await (async () => { const entry = await getEntry('posts', post.id); if (!entry) throw new Error(`Missing content entry: ${post.id}`); return render(entry); })() : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings.filter((heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label') ?? [];
const articleTags = post ? model.tags.filter((tag) => tag.lang === lang && tag.posts.some((item) => item.id === post.id)) : [];
const categoryBreadcrumbs = post ? post.categoryPaths.map((categoryPath, index) => ({ path: categoryPath, label: post.categoryLabels[index] })) : route.kind === 'category' ? model.categories.filter((category) => category.lang === lang && route.category.path.startsWith(category.path) && category.path !== path).sort((a, b) => a.depth - b.depth) : [];
const children = route.kind === 'category' ? model.categories.filter((category) => category.lang === lang && category.parentPath === path) : [];
const listingPosts = route.kind === 'category' ? route.category.posts : route.kind === 'tag' ? route.tag.posts : [];
function isCover(value: unknown): value is ImageMetadata { return typeof value === 'object' && value !== null && 'src' in value && typeof value.src === 'string' && 'width' in value && typeof value.width === 'number' && 'height' in value && typeof value.height === 'number' && 'format' in value; }
---
<Base lang={lang} title={title} description={description} path={path} alternates={alternates} translationUnavailable={Boolean(post && !alternates[otherLang(lang)])}>
  {route.kind !== 'search' && <nav class="breadcrumb" aria-label={lang === 'tr' ? 'Sayfa yolu' : 'Breadcrumb'}><a href={withBase(`/${lang}/`)}>{text.home}</a>{categoryBreadcrumbs.map((category) => <><span aria-hidden="true">/</span><a href={withBase(category.path)}>{category.label}</a></>)}{route.kind === 'tag' && <><span aria-hidden="true">/</span><a href={withBase(`/${lang}/tags/`)}>{text.tags}</a></>}<span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>}
  {post && Content ? <article><header class="article-header"><p class="eyebrow">{post.categoryLabels.join(' / ') || text.allPosts}</p><h1>{post.title}</h1>{post.summary && <p class="description">{post.summary}</p>}{(post.date || post.updated) && <div class="post-meta">{post.date && <time datetime={post.date.toISOString()}>{new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(post.date)}</time>}{post.updated && <span>{lang === 'tr' ? 'Güncellendi' : 'Updated'}: <time datetime={post.updated.toISOString()}>{new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(post.updated)}</time></span>}</div>}<div class="tag-list">{articleTags.map((tag) => <a class="chip" href={withBase(tag.path)}>#{tag.label}</a>)}</div></header>{isCover(post.cover) && <Image src={post.cover} alt={post.title} class="article-cover" loading="eager"/>}{headings.length > 0 && <details class="toc" open><summary>{text.toc}</summary><ol>{headings.map((heading) => <li style={heading.depth === 3 ? 'margin-left:16px' : undefined}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}<div class="prose"><Content /></div></article> : <>
    {route.kind === 'search' ? <header class="search-heading"><h1>{lang === 'tr' ? 'Arama sonuçları' : 'Search results'}</h1></header> : <header class="intro"><p class="eyebrow">{route.kind === 'category' ? text.categories : text.tags}</p><h1>{title}</h1><p>{route.kind === 'tags' ? text.siteDescription : `${listingPosts.length} ${text.postCount}`}</p></header>}
    {route.kind === 'tags' && <div class="collection-links">{model.tags.filter((tag) => tag.lang === lang).map((tag) => <a class="collection-link" href={withBase(tag.path)}><span>#{tag.label}</span><span class="count">{tag.posts.length}</span></a>)}</div>}
    {children.length > 0 && <nav class="tag-list" aria-label={text.categories}>{children.map((category) => <a class="chip" href={withBase(category.path)}>{category.label} · {category.posts.length}</a>)}</nav>}
    {(route.kind === 'category' || route.kind === 'tag') && <PostList posts={listingPosts} lang={lang}/>}
    {route.kind === 'search' && <><p id="search-status" class="search-status" data-search-status role="status"></p><ol class="search-results" data-search-results></ol><noscript><p>{lang === 'tr' ? 'Arama için JavaScript gerekir. Yazıları aşağıdan okuyabilirsiniz.' : 'Search requires JavaScript. Browse the posts below instead.'}</p><PostList posts={model.posts.filter((item) => item.lang === lang)} lang={lang}/></noscript></>}
  </>}
</Base>
