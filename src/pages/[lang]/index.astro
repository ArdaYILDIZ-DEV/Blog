---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getModel } from '../../lib/content';
import { languages, t, type Lang } from '../../lib/i18n';
import { withBase } from '../../lib/urls';
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const text = t(lang);
const model = await getModel();
const posts = model.posts.filter((post) => post.lang === lang);
const categories = model.categories.filter((category) => category.lang === lang && category.depth === 1);
---
<Base lang={lang} title="Arda's Blog" path={`/${lang}/`} alternates={{ tr: '/tr/', en: '/en/' }}>
  <header class="intro"><p class="eyebrow">{lang === 'tr' ? 'Yazılar' : 'Writing'}</p><h1>{lang === 'tr' ? 'Notlar, fikirler ve keşifler.' : 'Notes, ideas, and discoveries.'}</h1><p>{text.siteDescription}</p></header>
  {categories.length > 0 && <nav class="tag-list" aria-label={text.categories}>{categories.map((category) => <a class="chip" href={withBase(category.path)}>{category.label}<span> · {category.posts.length}</span></a>)}</nav>}
  <section aria-labelledby="posts-heading">
    <header class="section-heading"><h2 id="posts-heading">{text.allPosts}</h2><span>{posts.length} {text.postCount}</span></header>
    <PostList posts={posts} lang={lang}/>
  </section>
</Base>
