---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/urls';
---
<Base lang="en" title="404 — Page not found / Sayfa bulunamadı" path="/404.html">
  <section class="intro">
    <p class="eyebrow">404</p>
    <h1>Page not found<br/>Sayfa bulunamadı</h1>
    <p>The page may have moved. / Sayfa taşınmış olabilir.</p>
  </section>
  <div class="tag-list" style="margin-top:24px">
    <a class="btn" href={withBase('/tr/')} lang="tr">Türkçe ana sayfa</a>
    <a class="btn" href={withBase('/en/')} lang="en">English home</a>
  </div>
</Base>
