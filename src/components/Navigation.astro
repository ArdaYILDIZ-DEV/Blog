---
import type { BlogModel } from '../lib/model';
import { t, type Lang } from '../lib/i18n';
import { withBase } from '../lib/urls';
interface Props { lang: Lang; model: BlogModel; path: string; }
const { lang, model, path } = Astro.props;
const text = t(lang);
const categories = model.categories.filter((category) => category.lang === lang);
---
<a class="brand" href={withBase(`/${lang}/`)}>Arda's Blog</a>
<nav aria-label={lang === 'tr' ? 'Ana gezinme' : 'Main navigation'}>
  <a class="nav-row" aria-current={path === `/${lang}/` ? 'page' : undefined} href={withBase(`/${lang}/`)}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8"/></svg>{text.home}</a>
  <p class="nav-label">{text.categories}</p>
  {categories.map((category) => <a class="nav-row category-row" style={`--depth:${category.depth}`} aria-current={path === category.path ? 'page' : undefined} href={withBase(category.path)}><span class="category-name">{category.label}</span><span class="count">{category.posts.length}</span></a>)}
  <a class="nav-row" aria-current={path === `/${lang}/tags/` ? 'page' : undefined} href={withBase(`/${lang}/tags/`)}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h16M3 16h16M10 3l-4 18M18 3l-4 18"/></svg>{text.tags}</a>
</nav>
<div class="nav-footer"><a href={withBase(`/${lang}/rss.xml`)}>{text.rss}<span aria-hidden="true"> ↗</span></a><span>Arda's Blog</span></div>
